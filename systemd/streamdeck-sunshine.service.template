[Unit]
Description=Stream Deck Sunshine Server
Documentation=https://github.com/lizardbyte/sunshine
# Sunshine starts after Xorg and audio-capture (so StreamDeck-Capture sink exists)
After=streamdeck-xorg.service streamdeck-audio-capture.service
Requires=streamdeck-xorg.service
Wants=streamdeck-audio-capture.service

[Service]
Type=simple
User=__STREAM_USER__
Group=__STREAM_GROUP__
# Bind Sunshine to the streaming X display
Environment="DISPLAY=__STREAM_DISPLAY__"
# Audio capture: use streamdeck's PipeWire-Pulse (capture bridge feeds StreamDeck-Capture sink)
Environment="XDG_RUNTIME_DIR=/run/streamdeck-audio"
Environment="PULSE_SERVER=unix:/run/streamdeck-audio/pulse/native"
Environment="PULSE_RUNTIME_PATH=/run/streamdeck-audio"
# Sunshine config directory
Environment="SUNSHINE_CONFIG_DIR=__STREAM_HOME__/.config/sunshine"
# Sunshine log directory
Environment="SUNSHINE_LOG_DIR=/var/log/sunshine"
# PRIME offload: use NVIDIA GPU for rendering/encoding even with dummy X driver
Environment="__NV_PRIME_RENDER_OFFLOAD=1"
Environment="__GLX_VENDOR_LIBRARY_NAME=nvidia"
Environment="__VK_LAYER_NV_optimus=NVIDIA_only"
WorkingDirectory=__STREAM_HOME__
ExecStart=/usr/bin/sunshine
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
