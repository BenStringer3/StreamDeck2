[Unit]
Description=Stream Deck Xorg Display Server
Documentation=https://github.com/lizardbyte/sunshine
After=graphical.target
Wants=graphical.target

[Service]
# Type=simple because Xorg doesn't support systemd notify protocol
Type=simple
User=streamdeck
Group=streamdeck
# Xorg needs to run on a specific display
Environment="DISPLAY=:99"
# Xorg log location (in streamdeck-owned directory)
Environment="XORG_LOG=/var/log/streamdeck/Xorg.99.log"
# Use the generated Xorg config
# -config: use our dummy driver config
# -configdir "": prevent loading additional configs (avoids NVIDIA driver conflicts)
# -nolisten tcp: disable network connections for security
# -novtswitch: don't switch VTs
# -sharevts: allow running without exclusive VT access
ExecStart=/usr/bin/Xorg :99 -config /etc/X11/xorg.conf.d/99-streamdeck.conf -configdir "" -logfile ${XORG_LOG} -nolisten tcp -novtswitch -sharevts
# Wait for Xorg to be ready before considering the service started
ExecStartPost=/bin/sh -c 'for i in {1..30}; do DISPLAY=:99 xrandr --query > /dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
