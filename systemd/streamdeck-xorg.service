[Unit]
Description=Stream Deck Xorg Display Server
Documentation=https://github.com/lizardbyte/sunshine
After=graphical.target
Wants=graphical.target

[Service]
Type=notify
User=streamdeck
Group=streamdeck
# Xorg needs to run on a specific display
Environment="DISPLAY=:99"
# Xorg log location
Environment="XORG_LOG=/var/log/Xorg.99.log"
# Use the generated Xorg config
# -nolisten tcp: disable network connections for security
# vt8: use virtual terminal 8 (adjust if conflicts with other VTs)
ExecStart=/usr/bin/Xorg :99 -config /etc/X11/xorg.conf.d/99-streamdeck.conf -logfile ${XORG_LOG} -nolisten tcp vt8
# Notify systemd when ready
ExecStartPost=/bin/sh -c 'DISPLAY=:99 xrandr --query > /dev/null 2>&1 && systemd-notify --ready || exit 1'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
