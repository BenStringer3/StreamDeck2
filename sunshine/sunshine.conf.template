# Sunshine configuration for Stream Deck streaming
# Capture method: X11 capture backend (XCB)
# This captures the dedicated Xorg display :99
capture = x11

# X11 display to capture (must match systemd service DISPLAY)
# This is the dedicated streaming display, isolated from desktop session
x11_display = :99

# Audio capture: Sunshine uses PulseAudio on Linux. We run PipeWire-Pulse for streamdeck
# and feed ALSA loopback into the StreamDeck-Capture sink. This sink receives audio
# from the capture bridge (audio-capture-bridge.sh).
audio_sink = StreamDeck-Capture
stream_audio = 1

# Encoder: NVIDIA NVENC hardware encoding
encoder = nvenc

# GPU for NVENC (PCI bus id). Replace with your GPU's Bus:Device.Function (hex).
# Find with: nvidia-smi -q | grep "Bus Id" or lspci | grep -i nvidia (format 0000:BB:DD.F → 00000000:BB:DD.F).
# Install substitutes __ADAPTER_NAME__ from ADAPTER_NAME env or leaves this default.
adapter_name = __ADAPTER_NAME__

# Log directory (must be writable by stream user)
# Logs will be collected by collect-logs.sh
log_dir = /var/log/sunshine

# Web UI settings (optional, for pairing/config)
# Port range for streaming (default Sunshine ports)
port = 47989
# Web UI port (for pairing)
web_port = 47984

# Disable system tray (causes crashes in headless environment without GUI dependencies)
# The system tray requires GTK and bwrap which aren't available in the stream user session
system_tray = 0

# Note: Resolution is controlled by Xorg configuration (1280x800)
